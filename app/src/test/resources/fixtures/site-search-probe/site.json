{
  "name": "site-search-probe",
  "baseUrl": "https://normal.example",
  "input": "https://normal.example/",
  "routes": [
    {
      "match": "prefix:/s?k=",
      "page": "search.html"
    },
    {
      "match": "prefix:/comic/",
      "page": "detail.html"
    },
    {
      "match": "prefix:/read/",
      "page": "reader.html"
    },
    {
      "match": "exact:/",
      "page": "home.html"
    }
  ],
  "expect": {
    "outcome": "success",
    "baseUrl": "https://normal.example",
    "homeMin": 12,
    "chapterMin": 40,
    "imageMin": 10,
    "imageDistinctRatio": 1.0,
    "searchOnly": false,
    "searchPath": "/s?k={keyword}",
    "searchMethod": "get",
    "searchKeywordParam": "keyword"
  }
}
