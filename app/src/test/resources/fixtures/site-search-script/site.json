{
  "name": "脚本搜索站（没有 form，搜索地址只写在 JS 里）",
  "baseUrl": "https://normal.example",
  "input": "https://normal.example/",
  "routes": [
    {
      "match": "prefix:/ss?wd=",
      "page": "search.html"
    },
    {
      "match": "prefix:/comic/",
      "page": "detail.html"
    },
    {
      "match": "prefix:/read/",
      "page": "reader.html"
    },
    {
      "match": "exact:/",
      "page": "home.html"
    }
  ],
  "expect": {
    "outcome": "success",
    "baseUrl": "https://normal.example",
    "homeMin": 12,
    "chapterMin": 40,
    "imageMin": 10,
    "imageDistinctRatio": 1.0,
    "searchOnly": false,
    "searchPath": "/ss?wd={keyword}",
    "searchMethod": "get",
    "searchKeywordParam": "wd"
  }
}
