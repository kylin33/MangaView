{
  "name": "无语义命名站（class 全是 g-1/i-9/q-1，只能靠链接路径与 alt 判断）",
  "baseUrl": "https://opaque.example",
  "input": "https://opaque.example/",
  "routes": [
    {
      "match": "prefix:/search?keyword=",
      "page": "search.html"
    },
    {
      "match": "prefix:/comic/",
      "page": "detail.html"
    },
    {
      "match": "prefix:/read/",
      "page": "reader.html"
    },
    {
      "match": "exact:/",
      "page": "home.html"
    }
  ],
  "expect": {
    "outcome": "success",
    "baseUrl": "https://opaque.example",
    "homeMin": 20,
    "homeTitleMaxUntitled": 0,
    "homeTitleForbid": [
      "推广"
    ],
    "homeCoverForbid": [
      "/promo/"
    ],
    "chapterMin": 40,
    "chapterTitleLike": 0.9,
    "imageMin": 12,
    "imageDistinctRatio": 1.0,
    "searchPath": "/search?keyword={keyword}",
    "searchOnly": false
  }
}
