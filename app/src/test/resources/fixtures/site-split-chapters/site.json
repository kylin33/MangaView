{
  "name": "分卷站（章节拆成两个 tab，各 12 章，必须合并）",
  "baseUrl": "https://volume.example",
  "input": "https://volume.example/",
  "routes": [
    { "match": "prefix:/read/", "page": "reader.html" },
    { "match": "prefix:/c/", "page": "detail.html" },
    { "match": "exact:/", "page": "home.html" }
  ],
  "expect": {
    "outcome": "success",
    "homeMin": 6,
    "chapterMin": 24,
    "chapterTitleLike": 0.9,
    "imageMin": 8,
    "searchOnly": false
  }
}
